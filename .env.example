# Supervisa / Superjet Visa — environment template
# Copy to `.env` or `.env.local` and fill in values. Never commit real secrets.

# ── Backend (Express) ─────────────────────────────────────────
API_PORT=3001

# Email — Resend (preferred) or SendGrid or SMTP
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Superjet Visa
SMTP_FROM_EMAIL=no-reply@superjetglobal.com
SMTP_REPLY_TO=inquiry@superjetgroup.com
CONTACT_TO=inquiry@superjetgroup.com

# Passport OCR (server-only — never expose to the browser)
PASSPORT_OCR_API_KEY=

# Optional: Stripe secret (server-only; not used by frontend)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Frontend (Vite) — public values only ──────────────────────
# Publishable Stripe key is safe in the browser (pk_test_ / pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=
# Dev only: simulate checkout when Stripe is off (default on in DEV)
# VITE_STRIPE_MOCK_CHECKOUT=true

# Temporary client-side demo logins (gitignored .env only).
# Remove once server-side auth is implemented. Do NOT put Stripe/SMTP/OCR secrets here.
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_OPS_PASSWORD=
VITE_DEMO_PARTNER_PASSWORD=
